# Copy this file to .env and fill in your values.
# Never commit your real .env to git — it is already in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────
# Free Adzuna API credentials — sign up at https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Secret key for HMAC unique job identification and internal deduplication
HMAC_SECRET_KEY=change_this_to_a_random_secret_salt_or_passphrase

# ── Optional ──────────────────────────────────────────────────────────────────
# Port for the MCP server (default: 8000)
MCP_PORT=8000
Jooble_API=""